		<properties node_id="13" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf8\x00\x00\x07\x80\x00\x00\x04\x08\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x04\x07\x00\x00\x00\x00\x02\x00\x00\x00\x07\x80\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x04\x07', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'import numpy as np\nfrom Orange.data import Table\n\n# Separar X, Y y metas\nX     = in_data.X.copy()\ny     = in_data.Y.copy().ravel()\nmetas = in_data.metas.copy()\n\nnp.random.seed(42)\n\nidx_minority = np.where(y == 1)[0]   # solo fraudes\nidx_majority = np.where(y == 0)[0]   # solo legítimos\n\nn_needed = len(idx_majority) - len(idx_minority)\nprint(f"Legítimos  : {len(idx_majority)}")\nprint(f"Fraudes    : {len(idx_minority)}")\nprint(f"A generar  : {n_needed}")\n\n# Tomar muestras SOLO de la clase fraudulenta\nidx_synthetic = np.random.choice(idx_minority, size=n_needed, replace=True)\n\n# Agregar SOLO los fraudes nuevos al dataset original completo\nX_balanced     = np.vstack([X,     X[idx_synthetic]])\ny_balanced     = np.concatenate([y, y[idx_synthetic]])\nmetas_balanced = np.vstack([metas, metas[idx_synthetic]])\n\n# Mezclar todo\nshuffle_idx    = np.random.permutation(len(y_balanced))\nX_balanced     = X_balanced[shuffle_idx]\ny_balanced     = y_balanced[shuffle_idx]\nmetas_balanced = metas_balanced[shuffle_idx]\n\nprint(f"Total final: {len(y_balanced)}")\nprint(f"Fraudes finales   : {int((y_balanced == 1).sum())}")\nprint(f"Legítimos finales : {int((y_balanced == 0).sum())}")\n\nout_data = Table.from_numpy(\n    in_data.domain,\n    X_balanced,\n    y_balanced,\n    metas_balanced\n)', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x9f\x00\x00\x00`\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
