		<properties node_id="25" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf8\x00\x00\x07\x80\x00\x00\x04\x08\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x04\x07\x00\x00\x00\x00\x02\x00\x00\x00\x07\x80\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x04\x07', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'import numpy as np\nfrom Orange.data import Domain, ContinuousVariable\n\n# ── HELPERS ───────────────────────────────────────────────────────────────────\ndef get_col(domain, name):\n    """Devuelve el índice y si está en X o metas"""\n    for i, var in enumerate(domain.attributes):\n        if var.name == name:\n            return ("X", i)\n    for i, var in enumerate(domain.metas):\n        if var.name == name:\n            return ("meta", i)\n    return None\n\ndef get_val(row, domain, name):\n    loc = get_col(domain, name)\n    if loc is None:\n        return None\n    source, i = loc\n    if source == "X":\n        return row[i]\n    else:\n        return in_data.metas[list(in_data).index(row), i]\n\n# ── LEER COLUMNAS NECESARIAS ──────────────────────────────────────────────────\ndomain = in_data.domain\n\nmonto_idx    = domain.index("monto_declarado_ars")\nlimite_idx   = domain.index("limite_politica_ars")\nhistorial_idx= domain.index("historial_rechazos")\nhora_idx     = domain.index("hora_gasto")\ncomp_idx     = domain.index("tiene_comprobante")\ndia_idx      = domain.index("dia_semana")\n\nfines = {"Sábado", "Domingo", "S\\xe1bado", "S\\xe3bado"}\n\n# ── CALCULAR FEATURES NUEVAS ──────────────────────────────────────────────────\nexcede_limite          = []\nfuera_horario          = []\nsin_comp_alto_monto    = []\nreincidente            = []\n\n# Calcular percentil 75 del monto para "alto monto"\nmontos = in_data.X[:, monto_idx]\np75    = float(np.percentile(montos, 75))\n\nfor row in in_data:\n    monto     = float(row[monto_idx])\n    limite    = float(row[limite_idx])\n    historial = float(row[historial_idx])\n    hora_str  = str(row[hora_idx])\n    comp_str  = str(row[comp_idx])\n    dia_str   = str(row[dia_idx])\n\n    # 1. excede_limite: monto supera el tope de la política\n    excede_limite.append(1.0 if monto &gt; limite else 0.0)\n\n    # 2. fuera_horario: antes de las 6h, después de las 18h, o fin de semana\n    try:\n        hora = int(hora_str.split(":")[0])\n    except Exception:\n        hora = 12\n    es_finde      = dia_str in fines\n    es_fuera_hora = hora &lt; 6 or hora &gt;= 18\n    fuera_horario.append(1.0 if (es_finde or es_fuera_hora) else 0.0)\n\n    # 3. sin_comprobante_alto_monto: sin comprobante Y monto en cuartil superior\n    sin_comp  = comp_str.strip().lower() in ("no", "false", "0", "")\n    alto_monto = monto &gt;= p75\n    sin_comp_alto_monto.append(1.0 if (sin_comp and alto_monto) else 0.0)\n\n    # 4. reincidente: historial de rechazos &gt;= 2\n    reincidente.append(1.0 if historial &gt;= 2 else 0.0)\n\n# ── AGREGAR AL DOMINIO ────────────────────────────────────────────────────────\nnuevas_vars = [\n    ContinuousVariable("excede_limite"),\n    ContinuousVariable("fuera_horario"),\n    ContinuousVariable("sin_comp_alto_monto"),\n    ContinuousVariable("reincidente"),\n]\n\nnew_domain = Domain(\n    domain.attributes + tuple(nuevas_vars),\n    domain.class_var,\n    domain.metas\n)\n\nnuevas_cols = np.column_stack([\n    excede_limite,\n    fuera_horario,\n    sin_comp_alto_monto,\n    reincidente,\n])\n\nX_new = np.hstack([in_data.X, nuevas_cols])\n\nout_data = in_data.transform(new_domain)\nwith out_data.unlocked():\n    out_data.X = X_new\n\n# ── VERIFICACIÓN ──────────────────────────────────────────────────────────────\nprint(f"Features originales : {len(domain.attributes)}")\nprint(f"Features nuevas     : {len(nuevas_vars)}")\nprint(f"Features totales    : {len(new_domain.attributes)}")\nprint(f"excede_limite=1     : {int(sum(excede_limite))} registros")\nprint(f"fuera_horario=1     : {int(sum(fuera_horario))} registros")\nprint(f"sin_comp_alto=1     : {int(sum(sin_comp_alto_monto))} registros")\nprint(f"reincidente=1       : {int(sum(reincidente))} registros")', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x9f\x00\x00\x00`\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
